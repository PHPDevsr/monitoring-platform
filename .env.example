# =============================================================================
# Monitoring Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_ROOT_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SMTP - Email Notifications
# -----------------------------------------------------------------------------
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_FROM=alertmanager@example.com
SMTP_AUTH_USERNAME=alertmanager@example.com
SMTP_AUTH_PASSWORD=your-app-password
SMTP_REQUIRE_TLS=true
# Skip SMTP certificate verification only when explicitly enabled.
SMTP_TLS_INSECURE_SKIP_VERIFY=false

# Default for outgoing HTTPS notifications, including Slack and webhooks.
ALERTMANAGER_HTTP_INSECURE_SKIP_VERIFY=false

# Alert recipients
ALERT_EMAIL_TO=oncall@example.com

# -----------------------------------------------------------------------------
# Slack - Slack Notifications
# -----------------------------------------------------------------------------
SLACK_API_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_CHANNEL_CRITICAL=#alerts-critical
SLACK_CHANNEL_WARNING=#alerts-warning

# -----------------------------------------------------------------------------
# Prometheus
# -----------------------------------------------------------------------------
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=10GB

# -----------------------------------------------------------------------------
# Loki
# -----------------------------------------------------------------------------
LOKI_RETENTION_PERIOD=744h

# -----------------------------------------------------------------------------
# Blackbox Exporter
# -----------------------------------------------------------------------------
# false verifies TLS certificates; true skips verification for configured probes.
BLACKBOX_INSECURE_SKIP_VERIFY=false
